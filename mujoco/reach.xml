<mujoco model="two_link_reach">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual><global azimuth="90" elevation="-75"/></visual>
  <default>
    <joint type="hinge" axis="0 0 1" damping="2" armature="0.05"/>
    <geom type="capsule" size="0.045" density="500" contype="0" conaffinity="0"/>
  </default>
  <worldbody>
    <light pos="0 0 4"/>
    <geom type="plane" size="3 3 0.1" rgba="0.18 0.21 0.25 1"/>
    <body name="base" pos="0 0 0.2">
      <geom type="cylinder" size="0.12 0.2" rgba="0.4 0.4 0.4 1"/>
      <body name="link1">
        <joint name="shoulder"/>
        <geom fromto="0 0 0 1 0 0" rgba="0.2 0.5 0.9 1"/>
        <body name="link2" pos="1 0 0">
          <joint name="elbow"/>
          <geom fromto="0 0 0 1 0 0" rgba="0.1 0.8 0.7 1"/>
          <site name="ee" pos="1 0 0" size="0.065" rgba="1 0.8 0 1"/>
        </body>
      </body>
    </body>
    <body name="target" mocap="true" pos="1 1 0.2">
      <geom type="sphere" size="0.085" rgba="1 0.2 0.2 0.6"/>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_position" joint="shoulder" kp="100" kv="20" forcelimited="true" forcerange="-100 100"/>
    <position name="elbow_position" joint="elbow" kp="100" kv="20" forcelimited="true" forcerange="-100 100"/>
  </actuator>
</mujoco>
